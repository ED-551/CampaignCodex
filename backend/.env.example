# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# In containerised deployments DB_HOST should match the postgres service name.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=campaigncodex
DB_USER=campaigncodex
# Generate: openssl rand -base64 32
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=24h

# ─── Admin Seed Credentials ───────────────────────────────────────────────────
# Used by `npm run seed:admin` to create the first admin account.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Primary Admin ────────────────────────────────────────────────────────────
# The one account that can assign/revoke admin and moderator roles.
# Must match ADMIN_USERNAME (or the username you seeded manually).
# Kept server-side only — never shipped in the frontend JS bundle.
PRIMARY_ADMIN_USERNAME=your_admin_username

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Leave blank to stub email to console (fine for local/homelab installs).
# Sign up at https://resend.com for a free API key.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── Frontend URL (for CORS and email links) ──────────────────────────────────
CLIENT_URL=https://yourdomain.com

# ─── Feature Flags ────────────────────────────────────────────────────────────
# VTT: enable the /vtt Socket.io namespace and /api/vtt/* routes.
VTT_ENABLED=false

# ─── Compose settings (read by compose.yaml, not the Node process) ────────────
# Port the frontend container binds on the host (default: 8080).
HTTP_PORT=8080
