# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campaigncodex
DB_USER=campaigncodex
DB_PASSWORD=REDACTED_DB_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=24h

# ─── Admin Seed Credentials ───────────────────────────────────────────────────
# These must match what is stored in your Obsidian vault note.
# Run `npm run seed:admin` once after first DB init.
ADMIN_USERNAME=REDACTED_ADMIN_USERNAME
ADMIN_PASSWORD=REDACTED_ADMIN_PASSWORD

# ─── Primary Admin ────────────────────────────────────────────────────────────
# The one account that can assign/revoke admin and moderator roles.
# Must match the username seeded in the DB. Kept server-side only so this
# privileged identifier never ships in the compiled frontend JS bundle.
# Falls back to the seeded default if unset (safe for dev; set in production).
PRIMARY_ADMIN_USERNAME=REDACTED_PRIMARY_ADMIN_USERNAME

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Leave blank to stub email to console (safe for homelab v1)
RESEND_API_KEY=
EMAIL_FROM=noreply@campaigncodex.net

# ─── Frontend URL (for CORS and email links) ──────────────────────────────────
# Development:
# CLIENT_URL=http://localhost:5173
# Production:
CLIENT_URL=https://campaigncodex.net
