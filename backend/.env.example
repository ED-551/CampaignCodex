# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# In containerised deployments DB_HOST should match the postgres service name.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=campaigncodex
DB_USER=campaigncodex
# Generate: openssl rand -base64 32
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=24h

# ─── Admin Seed Credentials ───────────────────────────────────────────────────
# Used by `npm run seed:admin` to create the first admin account.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Primary Admin ────────────────────────────────────────────────────────────
# The one account that can assign/revoke admin and moderator roles.
# Must match ADMIN_USERNAME (or the username you seeded manually).
# Kept server-side only — never shipped in the frontend JS bundle.
PRIMARY_ADMIN_USERNAME=your_admin_username

# ─── Email ────────────────────────────────────────────────────────────────────
# Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is set, else emails
# are printed to the console (fine for local dev).
# Sign up at https://resend.com for a free API key.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=            # blank = TLS on port 465, STARTTLS otherwise
# true | false | auto (auto = required only when an email provider is set)
# REQUIRE_EMAIL_VERIFICATION=auto

# ─── Frontend URL (for CORS and email links) ──────────────────────────────────
CLIENT_URL=https://yourdomain.com

# ─── Feature Flags ────────────────────────────────────────────────────────────
# VTT: enable the /vtt Socket.io namespace and /api/vtt/* routes.
VTT_ENABLED=false

# ─── Reverse proxies ──────────────────────────────────────────────────────────
# Number of proxies in front of the API (used to find the client IP for rate
# limiting). 1 = a single nginx in front.
TRUST_PROXY=1

# ─── Docker / Podman ──────────────────────────────────────────────────────────
# This file is for running the backend directly with Node. For the container
# stack, use the .env.example at the repository root with compose.yaml.
