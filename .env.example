# CampaignCodex — instance settings for compose.yaml
#
# Copy to .env (same folder as compose.yaml) and fill in the REQUIRED values.
# Never commit your .env.

# ─── Required ─────────────────────────────────────────────────────────────────

# Database password. Generate one with:
#   openssl rand -hex 32
DB_PASSWORD=

# Signs login tokens — at least 32 characters. Generate one with:
#   openssl rand -hex 64
# Changing it logs everyone out.
JWT_SECRET=

# The address people type into their browser to reach this instance, without
# a trailing slash. Used for CORS and for links in emails.
#   Public site:   https://codex.example.com
#   Trying it out: http://127.0.0.1:8080   (the server rejects "localhost" here)
CLIENT_URL=

# Your admin account, created automatically on first start. Log in with these,
# then change the password from the app. Changing them here later does NOT
# update an existing account.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Host port the site is served on.
HTTP_PORT=8080

# Virtual tabletop (maps, tokens, fog of war). true or false.
VTT_ENABLED=false

# ─── Email ────────────────────────────────────────────────────────────────────
# Used for sign-up verification, password resets and the newsletter.
# Pick one: Resend (RESEND_API_KEY), SMTP (SMTP_HOST), or neither. With neither,
# emails — including password-reset links — are only printed to the backend log.
# Resend wins if both are set.
EMAIL_FROM=noreply@example.com

# Resend (https://resend.com)
RESEND_API_KEY=

# SMTP — any mail server or relay (your provider, Gmail app password, Mailgun,
# Postmark, Fastmail, …). Port 587 uses STARTTLS; port 465 uses TLS from the
# start. SMTP_SECURE=true/false overrides that; leave it blank to decide by port.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Must new accounts confirm their email before logging in? true, false or auto.
# auto = yes when Resend or SMTP is set above, no otherwise (new users are
# logged straight in). Admins can also verify a user from the Admin dashboard.
REQUIRE_EMAIL_VERIFICATION=auto

# How many reverse proxies sit in front of this stack's frontend container.
# 1 = people connect straight to HTTP_PORT. Set to 2 if you put Caddy,
# Traefik, nginx or a Cloudflare Tunnel in front, so rate limiting sees each
# visitor's real IP instead of your proxy's.
TRUST_PROXY=1

# The one account allowed to grant admin and moderator roles.
# Defaults to ADMIN_USERNAME.
# PRIMARY_ADMIN_USERNAME=

# How long a login lasts.
# JWT_EXPIRES_IN=24h

# Pin a release instead of tracking the latest build, e.g. :1.2.0
# BACKEND_IMAGE=ghcr.io/ed-551/campaigncodex-backend:latest
# FRONTEND_IMAGE=ghcr.io/ed-551/campaigncodex-frontend:latest
